    {
      "id": "1775225989512",
      "lines": [
        "秦时明月汉时关，",
        "万里长征人未还。",
        "但使龙城飞将在，",
        "不教胡马度阴山。"
      ],
      "title": "出塞",
      "author": "王昌龄",
      "addedAt": "2026-04-03",
      "dynasty": "唐"
    },
    {
      "id": "1775226049655",
      "lines": [
        "爆竹声中一岁除，",
        "春风送暖入屠苏。",
        "千门万户曈曈日，",
        "总把新桃换旧符。"
      ],
      "title": "元日",
      "author": "王安石",
      "addedAt": "2026-04-03",
      "dynasty": "宋"
    },
    {
      "id": "1775226120865",
      "lines": [
        "千山鸟飞绝，",
        "万径人踪灭。",
        "孤舟蓑笠翁，",
        "独钓寒江雪。"
      ],
      "title": "江雪",
      "author": "柳宗元",
      "addedAt": "2026-04-03",
      "dynasty": "唐"
    },
    {
      "id": "1775226477059",
      "lines": [
        "竹外桃花三两枝，",
        "春江水暖鸭先知。",
        "蒌蒿满地芦芽短，",
        "正是河豚欲上时。"
      ],
      "title": "惠崇春江晚景(其一)",
      "author": "苏轼",
      "addedAt": "2026-04-03",
      "dynasty": "宋"
    },
    {
      "id": "1775227416177",
      "lines": [
        "两两归鸿欲破群，",
        "依依还似北归人。",
        "遥知朔漠多风雪，",
        "更待江南半月春。"
      ],
      "title": "惠崇春江晚景(其二)",
      "author": "苏轼",
      "addedAt": "2026-04-03",
      "dynasty": "宋"
    },
    {
      "id": "1775227493901",
      "lines": [
        "清明时节雨纷纷，",
        "路上行人欲断魂。",
        "借问酒家何处有，",
        "牧童遥指杏花村。"
      ],
      "title": "清明",
      "author": "杜牧",
      "addedAt": "2026-04-03",
      "dynasty": "唐"
    },
    {
      "id": "1775228014247",
      "lines": [
        "远上寒山石径斜，",
        "白云生处有人家。",
        "停车坐爱枫林晚，",
        "霜叶红于二月花。"
      ],
      "title": "山行",
      "author": "杜牧",
      "addedAt": "2026-04-03",
      "dynasty": "唐"
    },
    {
      "id": "1775228159487",
      "lines": [
        "月落乌啼霜满天，",
        "江枫渔火对愁眠。",
        "姑苏城外寒山寺，",
        "夜半钟声到客船。"
      ],
      "title": "枫桥夜泊",
      "author": "唐",
      "addedAt": "2026-04-03",
      "dynasty": "张继"
    },
    {
      "id": "1775267917739",
      "lines": [
        "大雪压青松，",
        "青松挺且直。",
        "要知松高洁，",
        "待到雪化时。"
      ],
      "title": "青松",
      "author": "陈毅",
      "addedAt": "2026-04-04",
      "dynasty": "现代"
    },
    {
      "id": "1775398133160",
      "lines": [
        "锄禾日当午，",
        "汗滴禾下土。",
        "谁知盘中餐，",
        "粒粒皆辛苦。"
      ],
      "title": "悯农",
      "author": "李绅",
      "addedAt": "2026-04-05",
      "dynasty": "唐"
    },
    {
      "id": "1775475024315",
      "lines": [
        "小时不识月，",
        "呼作白玉盘。",
        "又疑瑶台镜，",
        "飞在青云端。"
      ],
      "title": "古朗月行",
      "author": "李白",
      "addedAt": "2026-04-06",
      "dynasty": "唐"
    },
    {
      "id": "1775475100257",
      "lines": [
        "春眠不觉晓，",
        "处处闻啼鸟。",
        "夜来风雨声，",
        "花落知多少。"
      ],
      "title": "春晓",
      "author": "孟浩然",
      "addedAt": "2026-04-06",
      "dynasty": "唐"
    },
    {
      "id": "1775475196874",
      "lines": [
        "小娃撑小艇，",
        "偷采白莲回。",
        "不解藏踪迹，",
        "浮萍一道开。"
      ],
      "title": "池上",
      "author": "白居易",
      "addedAt": "2026-04-06",
      "dynasty": "唐"
    },
    {
      "id": "1775738740666",
      "lines": [
        "千里莺啼绿映红，",
        "水村山郭酒旗风。",
        "南朝四百八十寺，",
        "多少楼台烟雨中。"
      ],
      "title": "江南春",
      "author": "杜牧",
      "addedAt": "2026-04-09",
      "dynasty": "唐"
    },
    {
      "id": "1776084553239",
      "lines": [
        "好雨知时节，",
        "当春乃发生。",
        "随风潜入夜，",
        "润物细无声。"
      ],
      "title": "春夜喜雨",
      "author": "杜甫",
      "addedAt": "2026-04-13",
      "dynasty": "唐"
    },
    {
      "id": "1776575559452",
      "lines": [
        "草长莺飞二月天，",
        "拂堤杨柳醉春烟。",
        "儿童散学归来早，",
        "忙趁东风放纸鸢。"
      ],
      "title": "村居",
      "author": "高鼎",
      "addedAt": "2026-04-19",
      "dynasty": "清"
    },
    {
      "id": "1776575702658",
      "lines": [
        "一去二三里，",
        "烟村四五家。",
        "亭台六七座，",
        "八九十枝花。"
      ],
      "title": "山村咏怀",
      "author": "",
      "addedAt": "2026-04-19",
      "dynasty": "北宋"
    },
    {
      "id": "1776589810876",
      "lines": [
        "泉眼无声惜细流，",
        "树阴照水爱晴柔。",
        "小荷才露尖尖角，",
        "早有蜻蜓立上头。"
      ],
      "title": "小池",
      "author": "杨万里",
      "addedAt": "2026-04-19",
      "dynasty": "宋"
    },
    {
      "id": "1776863738484",
      "lines": [
        "孤山寺北贾亭西，",
        "水面初平云脚低。",
        "几处早莺争暖树，",
        "谁家新燕啄春泥。"
      ],
      "title": "钱塘湖春行",
      "author": "白居易",
      "addedAt": "2026-04-22",
      "dynasty": "唐"
    }
  ],
